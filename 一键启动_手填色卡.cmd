@echo off
rem ============================================================
rem  lumina studio handfill cards - one-click launcher
rem
rem  1. locates lumina_singlestage_gui.html (next to this file
rem     first, then a few common places)
rem  2. clears the Windows "downloaded from the Internet" mark
rem     (Unblock-File) so the browser does not treat it as a
rem     restricted site
rem  3. opens it in your default browser
rem
rem  Usage: just double-click this file, keeping it in the same
rem  folder as lumina_singlestage_gui.html.
rem
rem  Optional switch from a console:
rem      --test   locate and report only; do not unblock or open
rem
rem  The real PowerShell payload is embedded below as UTF-16LE
rem  Base64 (that is what -EncodedCommand consumes). A readable
rem  copy of the same script sits next to this file as a .ps1
rem  with the same base name.
rem ============================================================
chcp 65001 >nul 2>&1
setlocal
title handfill cards launcher
set "LUMINA_TOOL_DIR=%~dp0"
if /i "%~1"=="--test" set "LUMINA_TOOL_DRYRUN=1"
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set RC=%ERRORLEVEL%
if not "%RC%"=="0" (
  echo.
  echo ------------------------------------------------------------
  echo  Failed. Exit code: %RC%
  echo  Press any key to close.
  echo ------------------------------------------------------------
  pause >nul
)
endlocal